# Copy to .env.local for `next` and .env for the worker / drizzle-kit.
# Every value below has a working local default; nothing here requires a
# cloud account to run the app.

# --- Database -------------------------------------------------------------
# Port 5434 to avoid colliding with a local Homebrew postgres on 5432 (and other projects on 5434).
DATABASE_URL=postgresql://gatherio:gatherio@localhost:5434/gatherio

# --- App ------------------------------------------------------------------
APP_URL=http://localhost:3000
# Used to sign recipient sessions and local upload tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-insecure-secret-replace-me-0000000000

# --- Adapters -------------------------------------------------------------
# storage: local | r2
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage

# Cloudflare R2 (STORAGE_DRIVER=r2). S3-compatible; region is always "auto".
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# notify: local | smtp | postmark
NOTIFY_DRIVER=local
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Gather <no-reply@gather.local>"
# POSTMARK_TOKEN=

# scan: noop | clamav
SCAN_DRIVER=noop

# --- Recipient page (Stage 6) ----------------------------------------------
UPLOAD_MAX_BYTES=26214400
UPLOAD_PRESIGN_TTL_SECONDS=900
RECIPIENT_SESSION_TTL_SECONDS=3600

# --- Manual reminders (Stage 8.5) ------------------------------------------
# Minimum gap between two manual reminders on the same case.
REMINDER_COOLDOWN_SECONDS=900
